# Banco PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/framestudio?schema=public"

# URL pública do site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp no formato internacional, somente números (ex.: 5592999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER="5592999999999"

# SMTP para enviar OTP e confirmação
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="seu-email@example.com"
SMTP_PASS="sua-senha-de-app"
EMAIL_FROM="Frame Studio <seu-email@example.com>"

# Mercado Pago: usar credenciais de TESTE durante desenvolvimento
MERCADOPAGO_ACCESS_TOKEN="TEST-COLOQUE-SEU_TOKEN_AQUI"
MERCADOPAGO_WEBHOOK_SECRET=""

# Chave aleatória forte para proteger dados temporários
APP_SECRET="troque-por-uma-chave-aleatoria-longa"
